<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <include
        android:id="@+id/title_bar"
        layout="@layout/common_include_header" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">
        <LinearLayout
            android:id="@+id/ll_game_name_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >

            <TextView
                android:id="@+id/tv_tag1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:text="*"
                android:textColor="#F16C2F" />

            <TextView
                android:id="@+id/tv_game_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:text="@string/competition_name"
                android:textColor="#3D3D3D"
                android:textFontWeight="500"
                android:textSize="18sp" />


        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_game_name_edit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/sh_r10_eeeeee"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/ll_game_name_label"
            >

            <EditText
                android:id="@+id/etGameName"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:layout_gravity="center_vertical"
                android:gravity="start|center_vertical"
                android:textColor="@color/black"
                android:textFontWeight="500"
                android:textSize="14sp"
                android:background="@null"
                android:singleLine="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/tvGoalTimeLabel"
                app:layout_constraintTop_toBottomOf="@id/tvTeamNameLabel"
                tools:text="08:36" />

            <TextView
                android:id="@+id/gameNameCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_lowgray"
                android:textSize="14sp"
                android:text="0/20"
                tools:text="1/20"
                />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_home_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="30dp"
            android:text="@string/home_team_name"
            android:textColor="#3D3D3D"
            android:textSize="18sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_game_name_edit" />

        <LinearLayout
            android:id="@+id/ll_host_name_edit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/sh_r10_eeeeee"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tv_home_name"
            >

            <EditText
                android:id="@+id/etHostName"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:layout_gravity="center_vertical"
                android:gravity="start|center_vertical"
                android:textColor="@color/black"
                android:textFontWeight="500"
                android:hint="@string/game_info_home_team_hint"
                android:textSize="14sp"
                android:textColorHint="@color/text_lowgray"
                android:background="@null"
                 />

            <TextView
                android:id="@+id/hostNameCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0/20"
                android:textColor="@color/text_lowgray"
                android:textSize="14sp"
                tools:text="1/20" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_guest_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="30dp"
            android:text="@string/guest_team_name"
            android:textColor="#3D3D3D"
            android:textSize="18sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_host_name_edit" />

        <LinearLayout
            android:id="@+id/ll_guest_name_edit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/sh_r10_eeeeee"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintTop_toBottomOf="@+id/tv_guest_name"
            >

            <EditText
                android:id="@+id/etGuestName"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:layout_marginEnd="10dp"
                android:layout_gravity="center_vertical"
                android:gravity="start|center_vertical"
                android:textColor="@color/black"
                android:textFontWeight="400"
                android:hint="@string/game_info_guest_team_hint"
                android:textSize="14sp"
                android:textColorHint="@color/text_lowgray"
                android:background="@null"
                />

            <TextView
                android:id="@+id/guestNameCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_lowgray"
                android:textSize="14sp"
                android:text="0/20"
                tools:text="1/20"
                />
        </LinearLayout>



        <TextView
            android:id="@+id/tv_ok"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:layout_marginTop="39dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_f16c2f_raduis10"
            android:gravity="center"
            android:text="@string/ok"
            android:textColor="#ffffff"
            android:textSize="20sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/ll_guest_name_edit"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>