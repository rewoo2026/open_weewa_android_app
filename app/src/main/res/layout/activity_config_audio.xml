<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_gray_light"
    android:orientation="vertical">

    <include
        android:id="@+id/title_bar"
        layout="@layout/common_include_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="33dp"
            android:paddingEnd="32dp"
            android:paddingTop="15dp"
            android:paddingBottom="15dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="5dp">

                    <LinearLayout
                        android:id="@+id/btn_record_audio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_f9f9f9_radius15"
                        android:paddingStart="23dp"
                        android:paddingEnd="22dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_record_audio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_gravity="center_vertical"
                            android:text="@string/record_audio_off"
                            android:textColor="@color/text_black_3D"
                            android:textFontWeight="500"
                            android:textSize="18sp" />

                        <ImageView
                            android:id="@+id/iv_record_audio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/audio_state" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="5dp">

                    <LinearLayout
                        android:id="@+id/btn_live_audio"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_f9f9f9_radius15"
                        android:paddingStart="23dp"
                        android:paddingEnd="22dp"
                        android:paddingTop="18dp"
                        android:paddingBottom="16dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_live_audio"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_gravity="center_vertical"
                            android:text="@string/live_audio_off"
                            android:textColor="@color/text_black_3D"
                            android:textFontWeight="500"
                            android:textSize="18sp" />

                        <ImageView
                            android:id="@+id/iv_live_audio"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:src="@drawable/audio_state" />

                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textFontWeight="500"
                android:textSize="20sp"
                android:textColor="@color/text_black_3D"
                android:text="录制/直播时音量"
                android:layout_marginStart="3dp"
                android:layout_marginTop="25dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="13dp"
                android:layout_marginStart="5dp"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="-15dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:layout_gravity="bottom"
                    android:textSize="12sp"
                    android:textColor="@color/login_dialog_edit_hint"/>

                <TextView
                    android:id="@+id/tv_volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="125"
                    android:textSize="14sp"
                    android:gravity="center"
                    android:layout_gravity="bottom"
                    android:textColor="@color/qccde_text_red"/>

                <TextView
                    android:layout_width="40dp"
                    android:layout_height="wrap_content"
                    android:text="255"
                    android:gravity="right"
                    android:layout_gravity="bottom"
                    android:textSize="12sp"
                    android:textColor="@color/login_dialog_edit_hint"/>

            </LinearLayout>

            <com.google.android.material.slider.Slider
                android:id="@+id/slider_volume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:trackColor="#ededed"
                app:thumbColor="@color/qccde_text_red"
                android:visibility="visible"
                android:theme="@style/Theme.MaterialComponents.DayNight.NoActionBar"
                android:value="50.0"
                android:valueFrom="0.0"
                android:valueTo="255.0"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="182dp"
                android:textColor="@color/gray"
                android:textSize="14sp"
                android:text="@string/hint_bigger_number_higher_volume"/>

        </LinearLayout>

    </ScrollView>

</LinearLayout>