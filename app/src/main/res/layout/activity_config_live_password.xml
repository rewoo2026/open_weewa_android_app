<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/bg_gray_light"
    android:orientation="vertical">

    <include
        android:id="@+id/title_bar"
        layout="@layout/common_include_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="33dp"
            android:paddingEnd="28dp">

            <LinearLayout
                android:id="@+id/btn_live_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="23dp"
                android:paddingBottom="22dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:text="@string/live_password"
                    android:textColor="@color/black"
                    android:textSize="20sp" />

                <com.xh.hotme.widget.SwitchButtonO
                    android:id="@+id/sb_live_password"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="11dp" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/live_password_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/set_live_password"
                    android:textColor="@color/text_gray_76"
                    android:textSize="18sp" />

                <EditText
                    android:id="@+id/et_live_password"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:visibility="visible"
                    android:layout_marginTop="8dp"
                    android:layout_marginEnd="19dp"
                    android:background="@drawable/round50_border_input_box"
                    android:gravity="top"
                    android:hint="@string/input_live_password"
                    android:paddingStart="23dp"
                    android:paddingEnd="23dp"
                    android:paddingTop="17dp"
                    android:paddingBottom="17dp"
                    android:textColor="@color/input_text_color"
                    android:textSize="18sp"
                    android:singleLine="true"
                    android:inputType="text" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hint_live_password"
                    android:textColor="@color/text_gray_76"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_ok"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:layout_gravity="center_horizontal|bottom"
                    android:layout_marginStart="3dp"
                    android:layout_marginTop="66dp"
                    android:background="@drawable/softap_dialog_open_btn"
                    android:gravity="center"
                    android:text="@string/ok"
                    android:textColor="@color/white"
                    android:textFontWeight="400"
                    android:textSize="20sp" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

</LinearLayout>