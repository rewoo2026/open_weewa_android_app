<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_gray_light"
    android:orientation="vertical">

    <include
        android:id="@+id/title_bar"
        layout="@layout/common_include_header" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="15dp"
            android:paddingBottom="15dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="34dp"
                android:layout_marginRight="34dp"
                android:text="@string/edit_match_name"
                android:textColor="@color/text_gray_76"
                android:textSize="18sp" />

            <EditText
                android:id="@+id/et_match_name"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginLeft="34dp"
                android:layout_marginTop="5dp"
                android:layout_marginRight="34dp"
                android:background="@drawable/round50_border_input_box"
                android:gravity="top"
                android:hint="@string/input_match_name"
                android:inputType="text"
                android:paddingStart="23dp"
                android:paddingTop="17dp"
                android:paddingEnd="23dp"
                android:paddingBottom="17dp"
                android:singleLine="true"
                android:textColor="@color/input_text_color"
                android:textSize="18sp"
                android:visibility="visible" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="34dp"
                android:layout_marginTop="27dp"
                android:layout_marginRight="34dp"
                android:text="@string/add_sponsor"
                android:textColor="@color/text_gray_76"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="34dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="34dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="128dp"
                    android:layout_height="56dp"
                    android:background="#f1f1f1">

                    <ImageView
                        android:id="@+id/watermark"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:maxWidth="128dp"
                        android:maxHeight="56dp"
                        android:src="@mipmap/watermark_placeholder" />

                </FrameLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />


                <TextView
                    android:id="@+id/btn_select_watermark"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:background="@drawable/device_fragment_no_device_item_btn_add"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="@string/upload_picture"
                    android:textColor="@color/white"
                    android:textFontWeight="400"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/btn_delete"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_gravity="center_vertical"
                    android:layout_marginLeft="13dp"
                    android:background="@drawable/round30_deep_red"
                    android:gravity="center"
                    android:paddingLeft="20dp"
                    android:paddingRight="20dp"
                    android:text="@string/delete"
                    android:textColor="@color/white"
                    android:textFontWeight="400"
                    android:textSize="14sp" />

            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="34dp"
                android:layout_marginTop="8dp"
                android:layout_marginRight="34dp"
                android:text="@string/watermark_size_suggestion"
                android:textColor="@color/gray"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginLeft="34dp"
                android:layout_marginTop="27dp"
                android:layout_marginRight="34dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginRight="34dp"
                    android:layout_weight="1"
                    android:text="@string/hide_obs_score"
                    android:textColor="@color/text_gray_76"
                    android:textSize="18sp" />

                <com.xh.hotme.widget.SwitchButtonO
                    android:id="@+id/sb_hide_obs_score"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical" />
            </LinearLayout>

            <TextView
                android:id="@+id/btn_ok"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginLeft="34dp"
                android:layout_marginTop="61dp"
                android:layout_marginRight="34dp"
                android:background="@drawable/softap_dialog_open_btn"
                android:gravity="center"
                android:text="@string/ok"
                android:textColor="@color/white"
                android:textFontWeight="400"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/btn_reset"
                android:layout_width="match_parent"
                android:layout_height="60dp"

                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginLeft="34dp"
                android:layout_marginTop="20dp"
                android:layout_marginRight="34dp"
                android:background="@drawable/round14_dark_blue_btn"
                android:gravity="center"
                android:text="@string/reset_watermark_config"
                android:textColor="@color/white"
                android:textFontWeight="400"
                android:textSize="20sp" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>