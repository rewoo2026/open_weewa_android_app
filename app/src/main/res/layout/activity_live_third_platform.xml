<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/titlebar"
            layout="@layout/common_include_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="34dp"
            android:paddingEnd="29dp">

            <LinearLayout
                android:id="@+id/group_plt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingTop="13dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="*"
                    android:layout_gravity="center_vertical"
                    android:textColor="@color/text_orange"
                    android:textFontWeight="400"
                    android:textSize="18sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/live_platform"
                    android:textColor="@color/text_black_3D"
                    android:textFontWeight="400"
                    android:textSize="18sp" />

                <androidx.appcompat.widget.AppCompatAutoCompleteTextView
                    android:id="@+id/plt_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:autoSizeMaxTextSize="18sp"
                    android:background="@null"
                    android:completionThreshold="100"
                    android:dropDownAnchor="@id/group_plt"
                    android:dropDownHorizontalOffset="5dp"
                    android:gravity="end|center_vertical"
                    android:drawableEnd="@mipmap/icon_push_select_more"
                    android:maxLength="20"
                    android:editable="false"
                    android:maxLines="1"
                    android:text="@string/live_platform_xqm"
                    android:drawablePadding="7dp"
                    android:textStyle="bold"
                    android:layout_marginLeft="20dp"
                    android:singleLine="true"
                    android:textCursorDrawable="@drawable/default_edit_color_cursor"
                    android:textColor="@color/text_black_3D"
                    android:textColorHint="#BEBEBE"
                    android:textSize="18sp" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#EDEDED"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <include
                    android:id="@+id/group_wx"
                    layout="@layout/layout_wx_channel_info"/>

                <include
                    android:id="@+id/group_dy"
                    layout="@layout/layout_dy_channel_info"
                    android:visibility="gone"/>

                <include
                    android:id="@+id/group_xqm"
                    layout="@layout/layout_xqm_info"
                    android:visibility="gone"/>

            </FrameLayout>

            <TextView
                android:id="@+id/btn_ok"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="80dp"
                android:layout_marginBottom="40dp"
                android:background="@drawable/sh_r10_f16c2f"
                android:gravity="center"
                android:text="@string/ok"
                android:textColor="#ffffff"
                android:textFontWeight="500"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>