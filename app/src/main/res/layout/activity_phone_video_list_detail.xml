<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="@dimen/common_action_bar_height"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:background="@color/white">

        <ImageView
            android:id="@+id/iv_back"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:layout_centerVertical="true"
            android:src="@mipmap/common_title_back"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="end"
            android:textSize="20sp"
            android:textFontWeight="400"
            android:layout_marginLeft="8dp"
            android:layout_marginRight="8dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/iv_back"
            app:layout_constraintEnd_toStartOf="@id/right"
            tools:text="title"
            />

        <LinearLayout
            android:id="@+id/right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_alignParentRight="true"
            android:paddingRight="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:text="选择"
                android:textColor="#3D3D3D"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@+id/ivAllSelect"
                app:layout_constraintEnd_toStartOf="@+id/ivAllSelect"
                app:layout_constraintTop_toTopOf="@+id/ivAllSelect" />

            <ImageView
                android:id="@+id/ivAllSelect"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="2dp"
                android:scaleType="centerInside"
                android:src="@mipmap/ic_unselect"
                android:layout_gravity="center_vertical"
                app:layout_constraintBottom_toBottomOf="@+id/title"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/title" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <View
        android:id="@+id/title_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/title_line"
        app:layout_constraintTop_toBottomOf="@id/title" />

    <include
        android:id="@+id/topDel"
        layout="@layout/video_del_title"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@+id/title"
        app:layout_constraintEnd_toEndOf="@+id/title"
        app:layout_constraintStart_toStartOf="@+id/title"
        app:layout_constraintTop_toTopOf="@+id/title" />

    <RadioGroup
        android:id="@+id/category"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="26dp"
        android:layout_marginTop="18dp"
        android:layout_marginRight="26dp"
        android:layout_marginBottom="18dp"
        android:orientation="horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/title_line">

        <RadioButton
            android:id="@+id/categoryAll"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:background="@drawable/video_category_selector"
            android:button="@null"
            android:checked="true"
            android:gravity="center"
            android:text="@string/video_category_all"
            android:textColor="@drawable/video_category_text_selector"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/categoryTop"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/video_category_selector"
            android:button="@null"
            android:gravity="center"
            android:text="@string/video_category_top"
            android:textColor="@drawable/video_category_text_selector"
            android:textSize="14sp" />

        <RadioButton
            android:id="@+id/categoryPlayback"
            android:layout_width="90dp"
            android:layout_height="40dp"
            android:layout_marginLeft="10dp"
            android:background="@drawable/video_category_selector"
            android:button="@null"
            android:gravity="center"
            android:text="@string/video_category_playback"
            android:textColor="@drawable/video_category_text_selector"
            android:textSize="14sp"

            />
    </RadioGroup>


    <include
        android:id="@+id/lltBottom"
        layout="@layout/video_layout_edit"
        android:layout_width="match_parent"
        android:layout_height="80dp"
        android:background="#FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"/>

    <com.xh.hotme.widget.MyRecyclerView
        android:id="@+id/recycleView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        app:layout_constraintBottom_toTopOf="@+id/lltBottom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/category" />

    <include
        android:id="@+id/emptyView"
        layout="@layout/adapter_item_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/lltBottom"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/category"

        />
</androidx.constraintlayout.widget.ConstraintLayout>