<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#FCFCFC">

    <include
        android:id="@+id/title_bar"
        layout="@layout/common_include_header" />

<!--    <EditText-->
<!--        android:id="@+id/et_register_account"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:hint="请输入手机号/邮箱" />-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginLeft="39dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="36dp"
        android:background="@drawable/login_view_edit_bg"
        android:orientation="horizontal">


        <EditText
            android:id="@+id/et_register_account"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/input_phone_or_email"
            android:inputType="text"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/login_dialog_edit_text"
            android:textColorHint="@color/login_dialog_edit_hint"
            android:textSize="16sp"
            />

        <ImageView
            android:id="@+id/clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="16dp"
            android:padding="4dp"
            android:src="@mipmap/login_dialog_clear" />

    </LinearLayout>

<!--    <EditText-->
<!--        android:id="@+id/et_register_verification_code"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:hint="请输入验证码" />-->

<!--    <Button-->
<!--        android:id="@+id/btn_register_get_verification_code"-->
<!--        android:layout_width="wrap_content"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="获取验证码" />-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginLeft="39dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="36dp"
        android:background="@drawable/login_view_edit_bg"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_register_verification_code"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/login_hint_input_sms"
            android:inputType="number"
            android:maxLength="16"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:textColor="@color/login_dialog_edit_text"
            android:textColorHint="@color/login_dialog_edit_hint"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_register_get_verification_code"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="8dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="@string/login_btn_send_sms"
            android:textColor="@color/text_orange"
            android:textSize="13sp" />

    </LinearLayout>

<!--    <EditText-->
<!--        android:id="@+id/et_register_password"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:hint="请输入密码"-->
<!--        android:inputType="textPassword" />-->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginLeft="39dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="36dp"
        android:background="@drawable/login_view_edit_bg"
        android:orientation="horizontal">


        <EditText
            android:id="@+id/et_register_password"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/login_input_password"
            android:inputType="textPassword"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/login_dialog_edit_text"
            android:textColorHint="@color/login_dialog_edit_hint"
            android:textSize="16sp"
            />

        <ImageView
            android:id="@+id/iv_show_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="16dp"
            android:padding="4dp"
            android:src="@mipmap/ic_eye_close" />

    </LinearLayout>
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="59dp"
        android:text="@string/password_too_short"
        android:textColor="@color/text_red"
        android:textSize="12dp"

        />


<!--    <EditText-->
<!--        android:id="@+id/et_register_confirm_password"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:hint="请确认密码"-->
<!--        android:inputType="textPassword" />-->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginLeft="39dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="36dp"
        android:background="@drawable/login_view_edit_bg"
        android:orientation="horizontal">


        <EditText
            android:id="@+id/et_register_confirm_password"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/login_confirm_password"
            android:inputType="textPassword"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/login_dialog_edit_text"
            android:textColorHint="@color/login_dialog_edit_hint"
            android:textSize="16sp"
            />

        <ImageView
            android:id="@+id/iv_show_confirm_password"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="16dp"
            android:padding="4dp"
            android:src="@mipmap/ic_eye_close" />

    </LinearLayout>

<!--    <EditText-->
<!--        android:id="@+id/et_register_device_id"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:hint="请输入设备 ID" />-->
    <LinearLayout
        android:id="@+id/et_register_device_id_view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginLeft="39dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="36dp"
        android:background="@drawable/login_view_edit_bg"
        android:orientation="horizontal">


        <EditText
            android:id="@+id/et_register_device_id"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/input_device_id"
            android:inputType="text"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/login_dialog_edit_text"
            android:textColorHint="@color/login_dialog_edit_hint"
            android:textSize="16sp"
           />

        <ImageView
            android:id="@+id/clear_device_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="16dp"
            android:padding="4dp"
            android:src="@mipmap/login_dialog_clear" />

    </LinearLayout>

<!--    <Button-->
<!--        android:id="@+id/btn_register_submit"-->
<!--        android:layout_width="match_parent"-->
<!--        android:layout_height="wrap_content"-->
<!--        android:text="注册" />-->

    <TextView
        android:id="@+id/btn_register_submit"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginLeft="39dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="36dp"
        android:background="@drawable/login_btn_background"
        android:gravity="center"
        android:text="@string/login_btn_register"
        android:textColor="@color/white"
        android:textSize="16sp" />
</LinearLayout>