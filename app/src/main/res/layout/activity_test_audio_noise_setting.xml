                android:layout_height="wrap_content"
                android:text="=== 音频降噪配置(start) ==="
                android:layout_marginTop="30dp"
                android:textSize="18sp"
                android:textColor="@color/black"
                android:gravity="center"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="这些配置具体啥意思,能起到什么效果,请问rk"
                android:textSize="12sp"
                android:textColor="@color/red"
                android:gravity="center"/>

            <com.zhy.view.flowlayout.FlowLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btn_toggle_sound_card"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#CCCECE"
                    android:text="关闭音量调整功能(使用硬件声卡)"
                    android:textColor="@android:color/black"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_toggle_anr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#CCCECE"
                    android:text="关闭音频降噪(anr)"
                    android:textColor="@android:color/black"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_toggle_agc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#CCCECE"
                    android:text="关闭音频增益(agc)"
                    android:textColor="@android:color/black"
                    android:textSize="12sp" />

                <Button
                    android:id="@+id/btn_toggle_hpf"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:backgroundTint="#CCCECE"
                    android:text="关闭音频过滤(hpf)"
                    android:textColor="@android:color/black"
                    android:textSize="12sp" />

            </com.zhy.view.flowlayout.FlowLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="提示: anr如果关闭, agc和hpf不会起作用"
                android:textSize="12sp"
                android:textColor="@color/gray"
                android:gravity="center"/>


            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="------- 以下为anr参数 --------"
                android:layout_marginTop="20dp"
                android:textSize="12sp"
                android:textColor="@color/red"
                android:gravity="center"/>

