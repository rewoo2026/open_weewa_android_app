<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@mipmap/icon_sermeal_list_bg1"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp"

    >

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="15dp"
        android:text="5次卡"
        android:textColor="#343332"
        android:textFontWeight="400"
        android:textSize="36sp"
        android:fontFamily="@font/youshebiaotihei"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tv_money1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="¥ "
        android:textColor="#F16C2F"
        android:textFontWeight="600"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_money2"
        app:layout_constraintRight_toLeftOf="@+id/tv_money2" />

    <TextView
        android:id="@+id/tv_money2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingRight="15dp"
        android:text="150"
        android:textColor="#F16C2F"
        android:textFontWeight="500"
        android:textSize="36sp"
        android:textStyle="bold"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/iv_left1"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="14dp"
        android:src="@mipmap/icon_dialog_expired_save"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title" />

    <TextView
        android:id="@+id/tv_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        android:text="5场云存储"
        android:textColor="#767676"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_left1"
        app:layout_constraintLeft_toRightOf="@+id/iv_left1"
        app:layout_constraintTop_toTopOf="@+id/iv_left1" />


    <ImageView
        android:layout_width="109dp"
        android:layout_height="70dp"
        android:layout_marginEnd="30dp"
        android:scaleType="fitXY"
        android:src="@mipmap/icon_sermeal_list_bg4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/constraintLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="14dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_left1">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayoutRecord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ffffff_raduis20_s_fdf3d8"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/iv_s"
            android:layout_width="17dp"
            android:layout_height="23dp"
            android:layout_marginLeft="10dp"
            android:src="@mipmap/icon_sermeal_s"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_left2"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginLeft="7dp"
            android:src="@mipmap/icon_dialog_expired_record"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/iv_s"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="3dp"
            android:paddingRight="10dp"
            android:text="20场比赛录制"
            android:textColor="#767676"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_left2"
            app:layout_constraintLeft_toRightOf="@+id/iv_left2"
            app:layout_constraintTop_toTopOf="@+id/iv_left2" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/constraintLayoutLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_ffffff_raduis20_s_fdf3d8"
            android:visibility="gone"
            android:layout_marginTop="4dp"
            tools:visibility="visible"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/constraintLayoutRecord">

            <ImageView
                android:id="@+id/iv_s_live"
                android:layout_width="17dp"
                android:layout_height="23dp"
                android:layout_marginLeft="10dp"
                android:src="@mipmap/icon_sermeal_s"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/iv_left3"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginLeft="7dp"
                android:src="@mipmap/icon_dialog_expired_live"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/iv_s_live"
                app:layout_constraintTop_toTopOf="parent"
                tools:visibility="visible"/>


            <TextView
                android:id="@+id/tv_live"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="3dp"
                android:paddingRight="10dp"
                android:text="10场赛事直播"
                android:textColor="#767676"
                android:textSize="12sp"
                app:layout_constraintBottom_toBottomOf="@+id/iv_left3"
                app:layout_constraintLeft_toRightOf="@+id/iv_left3"
                app:layout_constraintTop_toTopOf="@+id/iv_left3"
                tools:visibility="visible"
                />
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>


    <TextView
        android:id="@+id/tv_buy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_f16c2f_raduis10"
        android:paddingLeft="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:text="@string/purchase"
        android:textColor="#FFF5DE"
        android:textSize="14sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent" />

    <View
        android:layout_width="match_parent"
        android:layout_height="10dp"
        app:layout_constraintTop_toBottomOf="@+id/constraintLayout" />


</androidx.constraintlayout.widget.ConstraintLayout>