<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@mipmap/icon_sermeal_list_bg1"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp"
    android:paddingBottom="20dp"

    >

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingLeft="15dp"
        android:text="基础服务"
        android:textColor="#343332"
        android:textFontWeight="400"
        android:textSize="36sp"
        android:fontFamily="@font/youshebiaotihei"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <TextView
        android:id="@+id/tv_money1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingBottom="4dp"
        android:text="¥ "
        android:textColor="#F16C2F"
        android:textFontWeight="500"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_money2"
        app:layout_constraintRight_toLeftOf="@+id/tv_money2" />

    <TextView
        android:id="@+id/tv_money2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="9999"
        android:textColor="#F16C2F"
        android:textFontWeight="500"
        android:textSize="36sp"
        app:layout_constraintRight_toLeftOf="@+id/tv_money3"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_money3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingRight="15dp"
        android:paddingBottom="4dp"
        android:text="/年"
        android:textColor="#F16C2F"
        android:textFontWeight="500"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="@+id/tv_money2"
        app:layout_constraintRight_toRightOf="parent" />

    <ImageView
        android:id="@+id/iv_left1"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="14dp"
        android:src="@mipmap/icon_dialog_expired_record"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tv_title" />

    <ImageView
        android:id="@+id/iv_left11"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="15dp"
        android:visibility="gone"
        tools:visibility="visible"
        android:layout_marginTop="14dp"
        android:src="@mipmap/icon_rewo_big"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_left1" />

    <TextView
        android:id="@+id/tv_big_rewo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        tools:text="300场热我大数据"
        android:textColor="#767676"
        android:textSize="12sp"
        android:visibility="gone"
        tools:visibility="visible"
        app:layout_constraintBottom_toBottomOf="@+id/iv_left11"
        app:layout_constraintLeft_toRightOf="@+id/iv_left11"
        app:layout_constraintTop_toTopOf="@+id/iv_left11" />

    <ImageView
        android:id="@+id/iv_left2"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="14dp"
        android:src="@mipmap/icon_dialog_expired_save"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_left11" />

    <ImageView
        android:id="@+id/iv_left3"
        android:layout_width="14dp"
        android:layout_height="14dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="14dp"
        android:src="@mipmap/icon_dialog_expired_live"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/iv_left2" />

    <TextView
        android:id="@+id/tv_record"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        tools:text="300场比赛录制"
        android:textColor="#767676"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_left1"
        app:layout_constraintLeft_toRightOf="@+id/iv_left1"
        app:layout_constraintTop_toTopOf="@+id/iv_left1" />

    <TextView
        android:id="@+id/tv_save"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        tools:text="199场云存储"
        android:textColor="#767676"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_left2"
        app:layout_constraintLeft_toRightOf="@+id/iv_left2"
        app:layout_constraintTop_toTopOf="@+id/iv_left2" />

    <TextView
        android:id="@+id/tv_live"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="7dp"
        tools:text="50场赛事直播"
        android:textColor="#767676"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/iv_left3"
        app:layout_constraintLeft_toRightOf="@+id/iv_left3"
        app:layout_constraintTop_toTopOf="@+id/iv_left3" />


    <View
        android:layout_width="match_parent"
        android:layout_height="30dp"
        app:layout_constraintTop_toBottomOf="@+id/tv_live" />

    <ImageView
        android:layout_width="109dp"
        android:layout_height="70dp"
        android:scaleType="fitXY"
        android:layout_marginEnd="30dp"
        android:src="@mipmap/icon_sermeal_list_bg4"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent" />


    <TextView
        android:id="@+id/tv_buy"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="15dp"
        android:background="@drawable/bg_f16c2f_raduis10"
        android:paddingLeft="20dp"
        android:paddingTop="4dp"
        android:paddingEnd="20dp"
        android:paddingBottom="4dp"
        android:text="@string/purchase"
        android:textColor="#FFF5DE"
        android:textSize="14sp"
        app:layout_constraintTop_toTopOf="@+id/tv_live"
        app:layout_constraintBottom_toBottomOf="@+id/tv_live"
        app:layout_constraintRight_toRightOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>