<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="4dp"
   >

    <ImageView
        android:id="@+id/iv_storage_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginLeft="14dp"
        android:src="@mipmap/icon_dialog_expired_save"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_storage_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:textColor="#3D3D3D"
        android:textSize="14sp"
        android:text="60GB"
        app:layout_constraintLeft_toRightOf="@id/iv_storage_icon"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tv_storage_price"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:textColor="@color/orange"
        android:textSize="14sp"
        android:text="150元/年"
        android:textStyle="bold"
        app:layout_constraintLeft_toRightOf="@id/tv_storage_title"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

    <TextView
        android:id="@+id/tv_storage_buy"
        android:layout_width="60dp"
        android:layout_height="28dp"
        android:layout_marginRight="4dp"
        android:background="@drawable/bg_f16c2f_raduis30"
        android:gravity="center"
        android:text="@string/purchase"
        android:textColor="@color/white"
        android:textSize="12sp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>