<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <LinearLayout android:id="@+id/date_header" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingStart="20dp" android:paddingEnd="12dp" android:paddingTop="12dp" android:orientation="horizontal">
        <TextView android:id="@+id/date_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/text_black" />
        <TextView android:id="@+id/select_day" android:layout_width="wrap_content" android:layout_height="48dp" android:gravity="center" android:paddingStart="12dp" android:paddingEnd="12dp" android:text="@string/batch_select_day" android:textSize="14sp" android:textColor="#F16C2F" />
    </LinearLayout>
    <LinearLayout android:id="@+id/match_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:minHeight="90dp">
        <CheckBox android:id="@+id/select_match" android:layout_width="44dp" android:layout_height="48dp" android:buttonTint="#F16C2F" android:visibility="gone" />
        <ImageView android:id="@+id/cover" android:layout_gravity="top" android:layout_marginTop="2dp" android:layout_width="84dp" android:layout_height="58dp" android:contentDescription="@null" android:src="@mipmap/video_default_cover" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical">
            <TextView android:id="@+id/match_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="16sp" android:textColor="@color/text_black" />
            <TextView android:id="@+id/video_counts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:textSize="12sp" android:textColor="#767676" />
            <TextView android:id="@+id/block_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:textSize="12sp" android:textColor="#F16C2F" android:visibility="gone" />
            <LinearLayout android:id="@+id/ai_progress_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="8dp" android:visibility="gone">
                <TextView android:id="@+id/ai_status" android:layout_width="match_parent" android:layout_height="44dp" android:gravity="center_vertical" android:textSize="12sp" android:textColor="#F16C2F" />
                <TextView android:id="@+id/ai_upload_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#767676" />
                <ProgressBar android:id="@+id/ai_upload_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp" android:max="100" android:minHeight="6dp" android:maxHeight="6dp" android:progressDrawable="@drawable/match_ai_progress" android:progressTint="#F16C2F" android:progressBackgroundTint="#EEEEEE" />
                <TextView android:id="@+id/ai_analysis_percent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="#767676" />
                <ProgressBar android:id="@+id/ai_analysis_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="4dp" android:max="100" android:minHeight="6dp" android:maxHeight="6dp" android:progressDrawable="@drawable/match_ai_progress" android:progressTint="#F16C2F" android:progressBackgroundTint="#EEEEEE" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
