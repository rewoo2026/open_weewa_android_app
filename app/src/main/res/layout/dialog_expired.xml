<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:fillViewport="false"
    android:padding="24dp" android:clipToPadding="false" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_white_raduis20" android:padding="24dp" android:orientation="vertical">
        <ImageView android:id="@+id/iv_top" android:layout_width="88dp" android:layout_height="80dp"
            android:layout_gravity="center_horizontal" android:scaleType="fitCenter" android:src="@mipmap/icon_dialog_expired_topbg" android:importantForAccessibility="no" />
        <TextView android:id="@+id/tv_top" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center" android:textColor="#242424" android:textSize="20sp" android:textStyle="bold" />
        <TextView android:id="@+id/tv_bottom" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:gravity="center" android:textColor="#777777" android:textSize="14sp" android:lineSpacingExtra="4dp" />
        <LinearLayout android:id="@+id/features" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/iv_icon1" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_fff3ef_raduis" android:scaleType="centerInside" android:src="@mipmap/icon_dialog_expired_record" android:importantForAccessibility="no" />
                <TextView android:id="@+id/tv_text1" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/competition_record" android:textColor="#555555" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/iv_icon2" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_fff3ef_raduis" android:scaleType="centerInside" android:src="@mipmap/icon_dialog_expired_save" android:importantForAccessibility="no" />
                <TextView android:id="@+id/tv_text2" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/cloud_storage" android:textColor="#555555" android:textSize="12sp" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical">
                <ImageView android:id="@+id/iv_icon3" android:layout_width="40dp" android:layout_height="40dp" android:background="@drawable/bg_fff3ef_raduis" android:scaleType="centerInside" android:src="@mipmap/icon_dialog_expired_live" android:importantForAccessibility="no" />
                <TextView android:id="@+id/tv_text3" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="@string/competition_live" android:textColor="#555555" android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:id="@+id/live_feature" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal" android:gravity="center" android:visibility="gone">
            <ImageView android:id="@+id/iv_icon4" android:layout_width="32dp" android:layout_height="32dp" android:src="@mipmap/icon_dialog_expired_live" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tv_text4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="@string/live_count_exhausted_desc_price" android:textColor="#555555" android:textSize="14sp" />
        </LinearLayout>
        <View android:id="@+id/tv_line" android:layout_width="match_parent" android:layout_height="0dp" android:visibility="gone" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="28dp" android:orientation="horizontal" android:baselineAligned="false">
            <TextView android:id="@+id/tv_back" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:padding="10dp" android:layout_marginEnd="6dp" android:background="@drawable/bg_eeeeee_raduis10" android:gravity="center" android:text="稍后再说" android:textColor="#555555" android:textSize="15sp" />
            <TextView android:id="@+id/tv_buy" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:minHeight="48dp" android:padding="10dp" android:layout_marginStart="6dp" android:background="@drawable/bg_f16c2f_raduis10" android:gravity="center" android:text="@string/right_now_purchase" android:textColor="#FFFFFF" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
