<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@drawable/bluetooth_dialog_open_bg"
    android:orientation="vertical"
    android:paddingTop="20dp"
    android:paddingBottom="20dp">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="20dp"
        android:paddingRight="20dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:padding="10dp"
            android:src="@mipmap/dialog_close" />

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/device_unbind_title"
            android:textColor="@color/black"
            android:textFontWeight="400"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|end"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:lineSpacingExtra="4.8sp"
            android:text="@string/bluetooth_device_list_refresh"
            android:textColor="#ff3D3D3D"
            android:textFontWeight="400"
            android:textSize="16sp"
            android:visibility="gone"/>
    </FrameLayout>


    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="44dp"
        android:gravity="center_vertical"
        android:selectAllOnFocus="true"
        android:singleLine="true"
        android:text="@string/mobile"
        android:textColor="@color/text_black_3D"
        android:textSize="20sp"
        android:textFontWeight="400"
        />

    <TextView
        android:id="@+id/tv_mobile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginLeft="39dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="36dp"
        android:gravity="center_vertical"
        android:selectAllOnFocus="true"
        android:singleLine="true"
        android:textColor="#ff3D3D3D"
        android:textFontWeight="700"
        android:textSize="36sp"
        tools:text="@string/mobile" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_marginLeft="39dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="36dp"
        android:background="@drawable/login_view_edit_bg"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/et_sms_code"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="20dp"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/login_hint_input_sms"
            android:inputType="number"
            android:maxLength="16"
            android:maxLines="1"
            android:selectAllOnFocus="true"
            android:textColor="@color/login_dialog_edit_text"
            android:textColorHint="@color/login_dialog_edit_hint"
            android:textSize="16sp"  />

        <Button
            android:id="@+id/btn_send_sms_code"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_alignParentRight="true"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="8dp"
            android:background="@android:color/transparent"
            android:gravity="center"
            android:text="@string/login_btn_send_sms"
            android:textColor="@color/text_orange"
            android:textSize="13sp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_status"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:layout_marginLeft="39dp"
        android:layout_marginRight="36dp"
        android:background="@drawable/login_view_status_bg"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible">


        <TextView
            android:id="@+id/login_status"
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:drawableLeft="@mipmap/login_status_info"
            android:drawablePadding="10dp"
            android:gravity="center_vertical"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:selectAllOnFocus="true"
            android:singleLine="true"
            android:textColor="@color/white"
            android:textSize="16sp"
            tools:text="1423232323" />

    </LinearLayout>


    <TextView
        android:id="@+id/btn_unbound"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:layout_gravity="center_horizontal"
        android:layout_marginLeft="39dp"
        android:layout_marginTop="24dp"
        android:layout_marginRight="36dp"
        android:layout_marginBottom="56dp"
        android:background="@drawable/login_btn_background"
        android:gravity="center"
        android:text="@string/unbind"
        android:textColor="@color/white"
        android:textSize="16sp" />

</LinearLayout>