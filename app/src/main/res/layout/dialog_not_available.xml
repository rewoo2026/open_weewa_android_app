<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="39dp"
        android:layout_marginTop="30dp"
        android:layout_marginEnd="42dp"
        android:paddingBottom="30dp"
        android:background="@drawable/bg_white_raduis20"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/iv_top">

        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="26dp"
            android:layout_marginTop="56dp"
            android:text="@string/disable"
            android:textColor="#3D3D3D"
            android:textSize="22sp"
            android:textStyle="bold"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_content"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="19dp"
            android:text="@string/server_disable_content"
            android:textColor="#A5A5A5"
            android:textSize="16sp"
            android:layout_marginEnd="26dp"
            app:layout_constraintLeft_toLeftOf="@+id/tv_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_title" />


        <TextView
            android:id="@+id/tv_back"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_marginLeft="29dp"
            android:layout_marginTop="21dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_eeeeee_raduis10"
            android:gravity="center"
            android:text="@string/force_live"
            android:textColor="#3D3D3D"
            android:textSize="18sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/tv_buy"
            app:layout_constraintTop_toBottomOf="@+id/tv_content" />

        <TextView
            android:id="@+id/tv_buy"
            android:layout_width="0dp"
            android:layout_height="53dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="21dp"
            android:layout_marginEnd="29dp"
            android:background="@drawable/bg_f16c2f_raduis10"
            android:gravity="center"
            android:text="@string/right_now_purchase"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            app:layout_constraintLeft_toRightOf="@+id/tv_back"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_content" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <ImageView
        android:id="@+id/iv_top"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginEnd="70dp"
        android:src="@mipmap/icon_big_noservice"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>