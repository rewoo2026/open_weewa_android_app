<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">


    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_white_raduis40"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_calendar_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/share"
            android:textColor="#3D3D3D"
            android:textSize="20sp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_close"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingRight="20dp"
            android:src="@mipmap/dialog_close"
            app:layout_constraintBottom_toBottomOf="@+id/tv_calendar_title"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tv_calendar_title" />


        <View
            android:id="@+id/view_line"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#DDDDDD"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_calendar_title" />


        <ImageView
            android:id="@+id/iv_wx"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="38dp"
            android:background="@drawable/bg_f4f4f4_raduis100"
            android:scaleType="centerInside"
            android:src="@mipmap/icon_share_wx"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toLeftOf="@+id/iv_friend"
            app:layout_constraintTop_toBottomOf="@+id/view_line" />


        <ImageView
            android:id="@+id/iv_friend"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="38dp"
            android:background="@drawable/bg_f4f4f4_raduis100"
            android:scaleType="centerInside"
            android:src="@mipmap/icon_share_friend"
            app:layout_constraintLeft_toRightOf="@+id/iv_wx"
            app:layout_constraintRight_toLeftOf="@id/iv_link"
            app:layout_constraintTop_toBottomOf="@+id/view_line" />

        <ImageView
            android:id="@+id/iv_link"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="38dp"
            android:background="@drawable/bg_f4f4f4_raduis100"
            android:scaleType="centerInside"
            android:src="@mipmap/icon_share_link"
            app:layout_constraintLeft_toRightOf="@+id/iv_friend"
            app:layout_constraintRight_toLeftOf="@id/iv_code"
            app:layout_constraintTop_toBottomOf="@+id/view_line" />


        <ImageView
            android:id="@+id/iv_code"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="38dp"
            android:background="@drawable/bg_f4f4f4_raduis100"
            android:scaleType="centerInside"
            android:src="@mipmap/icon_share_code"
            app:layout_constraintLeft_toRightOf="@+id/iv_link"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_line" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:paddingBottom="44dp"
            android:text="@string/wechat"
            android:textColor="#767676"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@+id/iv_wx"
            app:layout_constraintRight_toRightOf="@+id/iv_wx"
            app:layout_constraintTop_toBottomOf="@+id/iv_wx" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/wechat_moment"
            android:textColor="#767676"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@+id/iv_friend"
            app:layout_constraintRight_toRightOf="@+id/iv_friend"
            app:layout_constraintTop_toBottomOf="@+id/iv_friend" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/copy_url"
            android:textColor="#767676"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@+id/iv_link"
            app:layout_constraintRight_toRightOf="@+id/iv_link"
            app:layout_constraintTop_toBottomOf="@+id/iv_link" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="11dp"
            android:text="@string/share_qcode"
            android:textColor="#767676"
            android:textSize="14sp"
            app:layout_constraintLeft_toLeftOf="@+id/iv_code"
            app:layout_constraintRight_toRightOf="@+id/iv_code"
            app:layout_constraintTop_toBottomOf="@+id/iv_code" />


    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>