<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:paddingBottom="30dp"
    android:paddingTop="5dp"
    android:paddingEnd="30dp"
    android:paddingStart="30dp"
    android:background="@drawable/leto_rounded_white_bg">

    <RelativeLayout
        android:id="@+id/dlg_title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:visibility="invisible"
        tools:visibility="visible">

        <TextView
            android:id="@+id/dlg_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:textColor="#333333"
            android:textSize="20sp"
            tools:text="标题" />
    </RelativeLayout>

    <TextView
        android:id="@+id/dlg_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/dlg_title_view"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:textColor="#333333"
        android:textSize="16sp"
        android:gravity="center"
        tools:text="message"
        />

    <LinearLayout
        android:id="@+id/dlg_btn_view"
        android:layout_below="@+id/dlg_msg"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_marginTop="25dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/dlg_left_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/common_dialog_btn_left"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/cancel"
            android:textColor="#ff767676"
            android:textSize="18sp"
            android:visibility="visible"
            tools:visibility="visible" />

        <View
            android:id="@+id/split_bar"
            android:layout_width="20dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/dlg_right_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/common_dialog_btn_right"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="@string/ok"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:visibility="visible"
            tools:visibility="visible" />
    </LinearLayout>

</RelativeLayout>
