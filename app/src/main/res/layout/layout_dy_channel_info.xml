<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="14dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/first_step"
            android:textStyle="bold"
            android:textFontWeight="700"
            android:textColor="@color/text_black_3D"
            android:textSize="18sp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="10"
            android:layout_marginLeft="10dp"
            android:layout_gravity="center_vertical"
            android:background="#EDEDED" />

    </LinearLayout>

    <TextView
        android:id="@+id/btn_get_qrcode"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/sh_r10_f16c2f"
        android:gravity="center"
        android:text="@string/live_get_login_token_of_dy"
        android:textColor="@color/white"
        android:textFontWeight="500"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/second_step"
            android:textStyle="bold"
            android:textFontWeight="700"
            android:textColor="@color/text_black_3D"
            android:textSize="18sp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="10"
            android:layout_marginLeft="10dp"
            android:layout_gravity="center_vertical"
            android:background="#EDEDED" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="@string/live_scan_qcode_of_dy"
        android:textColor="@color/text_black_3D"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:textFontWeight="400"
        android:textSize="18sp" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp">

        <ImageView
            android:id="@+id/iv_qrcode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:scaleType="center"
            android:src="@mipmap/ic_wechat_code"
            android:alpha="0.1"/>

        <TextView
            android:id="@+id/tv_hint_step2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textFontWeight="400"
            android:text="@string/live_first_step_get_login_token"
            android:layout_gravity="center"
            android:textSize="18sp"
            android:textColor="@color/text_black_3D"/>

    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="30dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/third_step"
            android:textStyle="bold"
            android:textFontWeight="700"
            android:textColor="@color/text_black_3D"
            android:textSize="18sp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="10"
            android:layout_marginLeft="10dp"
            android:layout_gravity="center_vertical"
            android:background="#EDEDED" />

    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:text="@string/finish_scan_get_pull_url_and_push_url"
        android:textColor="@color/text_black_3D"
        android:gravity="center"
        android:layout_marginTop="10dp"
        android:paddingStart="40dp"
        android:paddingEnd="40dp"
        android:textFontWeight="400"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/btn_get_url"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="10dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/sh_r10_f16c2f"
        android:gravity="center"
        android:text="@string/get_pull_url_and_push_url"
        android:textColor="@color/white"
        android:textFontWeight="500"
        android:textSize="18sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/group_code"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="20dp"
        android:visibility="gone">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:textColor="@color/text_black_3D"
            android:text="因安全原因获取地址失败, 需要进行验证码校验, 请点击&quot;获取验证码&quot;按钮, 收到后填入验证码再点击&quot;校验&quot;按钮"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:paddingStart="40dp"
            android:paddingEnd="40dp"
            android:textFontWeight="400"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/btn_get_code"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="20dp"
            android:layout_marginRight="20dp"
            android:background="@drawable/sh_r10_f16c2f"
            android:gravity="center"
            android:text="获取验证码"
            android:textColor="@color/white"
            android:textFontWeight="500"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp">

            <EditText
                android:id="@+id/et_code"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginLeft="20dp"
                android:background="@drawable/bg_f3f3f3_radius10_border"
                android:gravity="center_vertical"
                android:hint="填入验证码"
                android:singleLine="true"
                android:lines="1"
                android:minHeight="48dp"
                android:paddingStart="10dp"
                android:paddingTop="5dp"
                android:paddingEnd="10dp"
                android:paddingBottom="5dp"
                android:textColor="@color/text_gray_76"
                android:textFontWeight="400"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btn_validate_code"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginLeft="20dp"
                android:layout_marginRight="20dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:background="@drawable/sh_r10_f16c2f"
                android:gravity="center"
                android:text="校验验证码"
                android:textColor="@color/white"
                android:textFontWeight="500"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:paddingTop="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="*"
            android:textColor="@color/text_orange"
            android:textFontWeight="400"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/push_url"
            android:textColor="@color/text_black_3D"
            android:textFontWeight="400"
            android:textSize="18sp" />

    </LinearLayout>

    <EditText
        android:id="@+id/et_push_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_f3f3f3_radius10_border"
        android:gravity="top"
        android:editable="false"
        android:minHeight="92dp"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@color/text_gray_76"
        android:textFontWeight="400"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:background="#EDEDED" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:paddingTop="13dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="*"
            android:textColor="@color/text_orange"
            android:textFontWeight="400"
            android:textSize="18sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/pull_url"
            android:textColor="@color/text_black_3D"
            android:textFontWeight="400"
            android:textSize="18sp" />

    </LinearLayout>

    <EditText
        android:id="@+id/et_pull_url"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_f3f3f3_radius10_border"
        android:gravity="top"
        android:editable="false"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:minHeight="92dp"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@color/text_gray_76"
        android:textFontWeight="400"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="14dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:background="#EDEDED" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:paddingTop="11dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/push_key"
            android:textColor="@color/text_black_3D"
            android:textFontWeight="400"
            android:textSize="18sp" />

    </LinearLayout>

    <EditText
        android:id="@+id/et_push_key"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginLeft="20dp"
        android:layout_marginRight="20dp"
        android:background="@drawable/bg_f3f3f3_radius10_border"
        android:gravity="top"
        android:editable="false"
        android:minHeight="92dp"
        android:paddingStart="10dp"
        android:paddingTop="5dp"
        android:paddingEnd="10dp"
        android:paddingBottom="5dp"
        android:textColor="@color/text_gray_76"
        android:textFontWeight="400"
        android:textSize="14sp" />

</LinearLayout>