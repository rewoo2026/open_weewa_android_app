            android:gravity="center"
            android:text="@string/purchase"
            android:textColor="@color/white"
            android:textFontWeight="400"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/special_vip_time_info"
        >

        <TextView
            android:id="@+id/special_tv_base"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingRight="16dp"
            android:paddingBottom="5dp"
            android:text="@string/base_version"
            android:textColor="#3D3D3D"
            android:textSize="16sp"
            android:textStyle="bold|italic"
            android:visibility="gone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/special_vip_time_info"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/special_tv_pro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingRight="16dp"
            android:paddingBottom="5dp"
            android:text="@string/pro_version"
            android:textColor="#3D3D3D"
            android:textSize="16sp"
            android:textStyle="bold|italic"
            android:visibility="gone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/special_vip_time_info"
            tools:visibility="gone" />

        <TextView
            android:id="@+id/special_tv_fix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingRight="16dp"
            android:paddingBottom="5dp"
            android:text="@string/fix_version"
            android:textColor="#3D3D3D"
            android:textSize="16sp"
            android:textStyle="bold|italic"
            android:visibility="gone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/special_vip_time_info"
            tools:visibility="gone" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/special_pro_upgrade"
            android:layout_width="100dp"
            android:layout_height="28dp"
            android:background="@drawable/bg_f16c2f_raduis30"
            android:gravity="center"
            android:text="@string/upgrade_pro_version"
            android:textColor="@color/white"
            android:textFontWeight="400"
            android:textSize="12sp"
            android:layout_marginLeft="10dp"
            android:visibility="gone"
            tools:visibility="visible" />


    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/special_service_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/special_vip_time_info"
        tools:visibility="visible">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_user_package_count"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="#333333"
                android:gravity="center"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

         </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/view_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:background="@color/color_EEEEEE"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@id/special_service_item" />


</androidx.constraintlayout.widget.ConstraintLayout>