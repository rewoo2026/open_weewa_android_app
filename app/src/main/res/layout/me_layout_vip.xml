<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="20dp"
    android:paddingEnd="20dp">


    <TextView
        android:id="@+id/asx_ceshi"
        android:layout_width="@dimen/dp_200"
        android:layout_height="@dimen/dp_200"
        tools:text="ceshi"
        android:visibility="gone"/>

    <TextView
        android:id="@+id/tv_purchase_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="12sp"
        android:text="@string/purchase_history"
        android:textColor="@color/orange"
        android:textFontWeight="400"
        android:textSize="14sp"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/profile_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:orientation="vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_purchase_history">


        <ImageView
            android:id="@+id/avatar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:src="@mipmap/default_avatar"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="10dp"
            android:lineSpacingExtra="12sp"
            android:textColor="@color/text_black_3D"
            android:textFontWeight="700"
            android:textSize="20sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/avatar"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="游客43434" />


        <ImageView
            android:id="@+id/iv_vip_service"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="20dp"
            android:layout_marginTop="8dp"
            android:src="@mipmap/vip_service"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/avatar"
            app:layout_constraintTop_toBottomOf="@id/name"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_select_device_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/device_name_label"
            android:textColor="#999999"
            android:textSize="12sp"
            android:visibility="visible"
            app:layout_constraintRight_toLeftOf="@id/tv_select_device"
            app:layout_constraintTop_toBottomOf="@id/name" />

        <TextView
            android:id="@+id/tv_select_device"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:drawableRight="@mipmap/iv_me_devices_more"
            android:drawablePadding="6dp"
            android:textColor="#3D3D3D"
            android:textSize="12sp"
            android:visibility="visible"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@id/name"
            tools:text="设备名称" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/vip_time_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/camera_info_area_bg"
        android:minHeight="53dp"
        android:orientation="vertical"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/profile_info"
        tools:visibility="visible">

        <TextView
            android:id="@+id/vip_expired_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="12sp"
            android:text="@string/vip_expired_time"
            android:textColor="@color/text_lowgray"
            android:textFontWeight="500"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/vip_expired_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:textColor="@color/text_lowgray"
            android:textFontWeight="500"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/vip_expired_label"
            app:layout_constraintTop_toTopOf="parent"
            tools:text="2024-09-08" />

        <TextView
            android:id="@+id/vip_expired_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:text="@string/expired"
            android:textColor="@color/text_black_3D"
            android:textFontWeight="500"
            android:textSize="14sp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/vip_expired_time"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/vip_purchase"
            android:layout_width="78dp"
            android:layout_height="32dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_f16c2f_raduis30"
            android:gravity="center"
            android:text="@string/purchase"
            android:textColor="@color/white"
            android:textFontWeight="400"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/vip_upgrade"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/vip_extend"
            android:layout_width="78dp"
            android:layout_height="32dp"
            android:layout_marginRight="6dp"
            android:background="@drawable/bg_f16c2f_raduis30"
            android:gravity="center"
            android:text="@string/vip_renew"
            android:textColor="@color/white"
            android:textFontWeight="400"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/vip_upgrade"
            app:layout_constraintTop_toTopOf="parent" />


        <TextView
            android:id="@+id/vip_upgrade"
            android:layout_width="78dp"
            android:layout_height="32dp"
            android:layout_marginLeft="20dp"
            android:background="@drawable/r30_0b1f80"
            android:gravity="center"
            android:text="@string/upgrade"
            android:textColor="@color/white"
            android:textFontWeight="400"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


    </androidx.constraintlayout.widget.ConstraintLayout>



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/vip_time_info"
        >

        <TextView
            android:id="@+id/tv_rewo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingRight="16dp"
            android:paddingBottom="5dp"
            android:text="@string/rewoo_gift"
            android:textColor="#3D3D3D"
            android:textSize="16sp"
            android:textStyle="bold|italic"
            android:visibility="gone"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vip_time_info"
            tools:visibility="visible" />


        <TextView
            android:id="@+id/tv_service"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingRight="16dp"
            android:paddingBottom="5dp"
            android:text="@string/base_service"
            android:textColor="#999999"
            android:textSize="16sp"
            android:textStyle="bold|italic"
            android:visibility="gone"
            app:layout_constraintLeft_toRightOf="@+id/tv_rewo"
            app:layout_constraintTop_toBottomOf="@+id/vip_time_info"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_cord"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingRight="16dp"
            android:paddingBottom="5dp"
            android:text="@string/counts_gift_package"
            android:textColor="#999999"
            android:textSize="16sp"
            android:textStyle="italic|bold"
            android:visibility="gone"
            app:layout_constraintLeft_toRightOf="@+id/tv_service"
            app:layout_constraintTop_toBottomOf="@+id/vip_time_info"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingTop="15dp"
            android:paddingBottom="5dp"
            android:text="@string/record_package"
            android:textColor="#999999"
            android:textSize="16sp"
            android:textStyle="italic|bold"
            android:visibility="gone"
            app:layout_constraintLeft_toRightOf="@+id/tv_cord"
            app:layout_constraintTop_toBottomOf="@+id/vip_time_info"
            tools:visibility="visible" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/service_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="49dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/vip_time_info"
        tools:visibility="visible">

        <View
            android:id="@+id/view_item1"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:background="@mipmap/icon_item_y"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/iv_item_icon_1"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="14dp"
            android:src="@mipmap/icon_item_record"
            app:layout_constraintBottom_toBottomOf="@+id/view_item1"
            app:layout_constraintLeft_toLeftOf="@+id/view_item1"
            app:layout_constraintTop_toTopOf="@+id/view_item1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:text="@string/competition_record"
            android:textColor="#3D3D3D"
            android:textFontWeight="700"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/iv_item_icon_1"
            app:layout_constraintLeft_toRightOf="@+id/iv_item_icon_1"
            app:layout_constraintTop_toTopOf="@+id/iv_item_icon_1" />


        <ImageView
            android:id="@+id/iv_arrow1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:src="@mipmap/icon_item_arrow"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/view_item1"
            app:layout_constraintRight_toRightOf="@+id/view_item1"
            app:layout_constraintTop_toTopOf="@+id/view_item1" />


        <TextView
            android:id="@+id/tv_count1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:text="不限次"
            android:textColor="#F16C2F"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/view_item1"
            app:layout_constraintRight_toLeftOf="@+id/iv_arrow1"
            app:layout_constraintTop_toTopOf="@+id/view_item1" />


        <View
            android:id="@+id/view_item_bigdata"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:background="@mipmap/icon_item_y"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_item1" />


        <ImageView
            android:id="@+id/iv_item_icon_bigdata"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="14dp"
            android:src="@mipmap/icon_item_save"
            app:layout_constraintBottom_toBottomOf="@+id/view_item_bigdata"
            app:layout_constraintLeft_toLeftOf="@+id/view_item_bigdata"
            app:layout_constraintTop_toTopOf="@+id/view_item_bigdata" />

        <TextView
            android:id="@+id/tv_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:text="热我大数据"
            android:textColor="#3D3D3D"
            android:textFontWeight="700"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/iv_item_icon_bigdata"
            app:layout_constraintLeft_toRightOf="@+id/iv_item_icon_bigdata"
            app:layout_constraintTop_toTopOf="@+id/iv_item_icon_bigdata" />


        <ImageView
            android:id="@+id/iv_arrow21"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:src="@mipmap/icon_item_arrow"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/view_item_bigdata"
            app:layout_constraintRight_toRightOf="@+id/view_item_bigdata"
            app:layout_constraintTop_toTopOf="@+id/view_item_bigdata" />


        <TextView
            android:id="@+id/tv_count_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:text="3/300次"
            android:textColor="#F16C2F"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_arrow21"
            app:layout_constraintRight_toLeftOf="@+id/iv_arrow21"
            app:layout_constraintTop_toTopOf="@+id/iv_arrow21" />

        <androidx.constraintlayout.widget.Group
            android:id="@+id/group_big"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:constraint_referenced_ids="view_item_bigdata,iv_item_icon_bigdata,tv_big,tv_count_big" />

        <View
            android:id="@+id/view_item2"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:background="@mipmap/icon_item_y"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_item_bigdata" />


        <ImageView
            android:id="@+id/iv_item_icon_2"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="14dp"
            android:src="@mipmap/icon_item_save"
            app:layout_constraintBottom_toBottomOf="@+id/view_item2"
            app:layout_constraintLeft_toLeftOf="@+id/view_item2"
            app:layout_constraintTop_toTopOf="@+id/view_item2" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:text="@string/cloud_storage"
            android:textColor="#3D3D3D"
            android:textFontWeight="700"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/iv_item_icon_2"
            app:layout_constraintLeft_toRightOf="@+id/iv_item_icon_2"
            app:layout_constraintTop_toTopOf="@+id/iv_item_icon_2" />


        <ImageView
            android:id="@+id/iv_arrow2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:src="@mipmap/icon_item_arrow"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/view_item2"
            app:layout_constraintRight_toRightOf="@+id/view_item2"
            app:layout_constraintTop_toTopOf="@+id/view_item2" />


        <TextView
            android:id="@+id/tv_count2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:text="3/300次"
            android:textColor="#F16C2F"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_arrow2"
            app:layout_constraintRight_toLeftOf="@+id/iv_arrow2"
            app:layout_constraintTop_toTopOf="@+id/iv_arrow2" />


        <View
            android:id="@+id/view_item3"
            android:layout_width="0dp"
            android:layout_height="34dp"
            android:layout_marginTop="5dp"
            android:background="@mipmap/icon_item_y"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/view_item2" />


        <ImageView
            android:id="@+id/iv_item_icon_3"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="14dp"
            android:src="@mipmap/icon_item_live"
            app:layout_constraintBottom_toBottomOf="@+id/view_item3"
            app:layout_constraintLeft_toLeftOf="@+id/view_item3"
            app:layout_constraintTop_toTopOf="@+id/view_item3" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7dp"
            android:text="@string/competition_live"
            android:textColor="#3D3D3D"
            android:textFontWeight="700"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@+id/iv_item_icon_3"
            app:layout_constraintLeft_toRightOf="@+id/iv_item_icon_3"
            app:layout_constraintTop_toTopOf="@+id/iv_item_icon_3" />


        <ImageView
            android:id="@+id/iv_arrow3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:src="@mipmap/icon_item_arrow"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@+id/view_item3"
            app:layout_constraintRight_toRightOf="@+id/view_item3"
            app:layout_constraintTop_toTopOf="@+id/view_item3" />


        <TextView
            android:id="@+id/tv_count3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="15dp"
            android:text="3/300次"
            android:textColor="#F16C2F"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="@+id/iv_arrow3"
            app:layout_constraintRight_toLeftOf="@+id/iv_arrow3"
            app:layout_constraintTop_toTopOf="@+id/iv_arrow3" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!--添加的特殊套餐-->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/special_vip_time_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/camera_info_area_bg"
        android:minHeight="53dp"
        android:orientation="vertical"
        android:layout_marginTop="20dp"
        android:paddingLeft="10dp"
        android:paddingTop="10dp"
        android:paddingRight="10dp"
        android:paddingBottom="10dp"
        android:visibility="gone"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@id/service_item"
        tools:visibility="visible">

        <TextView
            android:id="@+id/special_vip_expired_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:lineSpacingExtra="12sp"
            android:text="@string/vip_expired_time"
            android:textColor="@color/text_lowgray"
            android:textFontWeight="500"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/special_vip_expired_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:textColor="@color/text_lowgray"
            android:textFontWeight="500"
            android:textSize="14sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/special_vip_expired_label"
