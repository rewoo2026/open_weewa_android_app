<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tl="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:layout_constraintWidth_percent="0.5"
    android:background="#e61D1D1D"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ll_title"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="20dp"
        android:orientation="vertical"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_state_host_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/sc_edit_tab_selector"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@drawable/sc_edit_tab_text_selector"
            android:textFontWeight="500"
            android:textSize="18sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5"
            tools:text="@string/home_team" />


        <TextView
            android:id="@+id/tv_state_guest_name"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:background="@drawable/sc_edit_tab_selector"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@drawable/sc_edit_tab_text_selector"
            android:textFontWeight="500"
            android:textSize="18sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_percent="0.5"
            tools:text="@string/guest_team" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <View
        android:id="@+id/view_title_split_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#733416"
        android:layout_marginTop="10dp"
        app:layout_constraintTop_toBottomOf="@+id/ll_title"
        app:layout_constraintLeft_toLeftOf="parent"
        />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@id/stateRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="10dp"
        app:layout_constraintBottom_toTopOf="@+id/view_function_split_line"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/view_title_split_line" />
    <View
        android:id="@+id/view_function_split_line"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#733416"
        app:layout_constraintTop_toBottomOf="@+id/stateRecyclerView"
        app:layout_constraintLeft_toLeftOf="parent"
        />
    <FrameLayout
        android:id="@+id/ll_state_function"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:paddingBottom="20dp"
        app:layout_constraintTop_toBottomOf="@+id/view_function_split_line"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_clear_state"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_f11313_raduis18"
                android:gravity="center"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:text="@string/clear_data"
                android:textColor="@color/white"
                android:textFontWeight="500"
                android:textSize="14sp" />

        </LinearLayout>

    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>