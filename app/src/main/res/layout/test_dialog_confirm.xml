<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:background="@drawable/leto_rounded_white_bg"
    android:paddingStart="30dp"
    android:paddingTop="5dp"
    android:paddingEnd="30dp"
    android:paddingBottom="30dp">

    <RelativeLayout
        android:id="@+id/dlg_title_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:visibility="invisible"
        tools:visibility="visible">

        <TextView
            android:id="@+id/dlg_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:drawablePadding="5dp"
            android:ellipsize="end"
            android:gravity="center_horizontal"
            android:singleLine="true"
            android:textColor="#333333"
            android:textSize="20sp"
            tools:text="标题" />
    </RelativeLayout>

    <TextView
        android:id="@+id/dlg_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/dlg_title_view"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="#333333"
        android:textSize="16sp"
        tools:text="message" />


    <TextView
        android:id="@+id/dlg_extend_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/dlg_msg"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textColor="#333333"
        android:textSize="16sp"
        tools:text="extend" />

    <LinearLayout
        android:id="@+id/dlg_btn_view"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@+id/dlg_extend_msg"
        android:layout_marginTop="25dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/dlg_left_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/common_dialog_btn_left"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="未通过"
            android:textColor="#ff767676"
            android:textSize="18sp"
            android:visibility="visible"
            tools:visibility="visible" />

        <View
            android:id="@+id/split_bar"
            android:layout_width="20dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/dlg_right_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/common_dialog_btn_right"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="通过"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:visibility="visible"
            tools:visibility="visible" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/dlg_audio_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/dlg_btn_view"
        android:layout_marginTop="25dp"
        android:orientation="vertical"
        android:visibility="gone"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            tools:visibility="visible">

            <TextView
                android:id="@+id/dlg_audio_record"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/common_dialog_btn_right"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="开始录制"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:visibility="visible"
                tools:visibility="visible" />


            <View
                android:layout_width="20dp"
                android:layout_height="match_parent" />

            <TextView
                android:id="@+id/dlg_audio_download"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/common_dialog_btn_right"
                android:gravity="center"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:text="开始下载"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:visibility="visible"
                tools:visibility="visible" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/dlg_download_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <LinearLayout
                android:id="@+id/dlg_dump_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="anr_in音频"
                    android:textColor="#ff767676"
                    android:textSize="18sp"
                    tools:visibility="visible" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/dlg_anr_in_play"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/common_dialog_btn_right"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="播放"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:visibility="visible"
                    tools:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="anr_out音频"
                    android:textColor="#ff767676"
                    android:textSize="18sp"
                    tools:visibility="visible" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/dlg_anr_out_play"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/common_dialog_btn_right"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="播放"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:visibility="visible"
                    tools:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="agc_out音频"
                    android:textColor="#ff767676"
                    android:textSize="18sp"
                    tools:visibility="visible" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/dlg_agc_out_play"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/common_dialog_btn_right"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="播放"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:visibility="visible"
                    tools:visibility="visible" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="hpf_out音频"
                    android:textColor="#ff767676"
                    android:textSize="18sp"
                    tools:visibility="visible" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/dlg_hpf_out_play"
                    android:layout_width="80dp"
                    android:layout_height="match_parent"
                    android:background="@drawable/common_dialog_btn_right"
                    android:gravity="center"
                    android:paddingLeft="10dp"
                    android:paddingRight="10dp"
                    android:text="播放"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:visibility="visible"
                    tools:visibility="visible" />

            </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:id="@+id/dlg_arecord_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="10dp"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:text="arecord音频"
                        android:textColor="#ff767676"
                        android:textSize="18sp"
                        tools:visibility="visible" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/dlg_arecord_play"
                        android:layout_width="80dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/common_dialog_btn_right"
                        android:gravity="center"
                        android:paddingLeft="10dp"
                        android:paddingRight="10dp"
                        android:text="播放"
                        android:textColor="@color/white"
                        android:textSize="18sp"
                        android:visibility="visible"
                        tools:visibility="visible" />

                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/dlg_again_view"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_below="@+id/dlg_audio_view"
        android:layout_marginTop="10dp"
        tools:visibility="visible">

        <TextView
            android:id="@+id/dlg_reboot_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/common_dialog_btn_left"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="重启相机"
            android:textColor="#ff767676"
            android:textSize="18sp"
            android:visibility="invisible"
            tools:visibility="visible" />

        <View
            android:id="@+id/split_bar2"
            android:layout_width="20dp"
            android:layout_height="match_parent" />

        <TextView
            android:id="@+id/dlg_retry_btn"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/common_dialog_btn_right"
            android:gravity="center"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:text="重试"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:visibility="visible"
            tools:visibility="visible" />
    </LinearLayout>
</RelativeLayout>
