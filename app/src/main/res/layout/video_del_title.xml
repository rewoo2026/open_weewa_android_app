<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lltDel"
    android:layout_width="match_parent"
    android:layout_height="@dimen/common_action_bar_height"
    android:background="@color/white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    tools:ignore="MissingDefaultResource">

    <ImageView
        android:id="@+id/ivCLose"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:scaleType="center"
        android:src="@mipmap/ic_topclose"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tvDelTitle"
        android:layout_width="0dp"
        android:layout_height="74dp"
        android:gravity="center"
        android:ellipsize="end"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:singleLine="true"
        android:textColor="@color/black"
        android:textSize="20sp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/tvSelectAll"
        app:layout_constraintStart_toEndOf="@id/ivCLose"
        tools:text="选择" />
    <ImageView
        android:id="@+id/ivDelAllSelect"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginEnd="12dp"
        android:layout_gravity="center_vertical"
        android:scaleType="centerInside"
        android:src="@mipmap/ic_unselect"
        app:layout_constraintBottom_toBottomOf="@+id/ivCLose"
        app:layout_constraintEnd_toEndOf="parent"
        />
    <TextView
        android:id="@+id/tvSelectAll"
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:text="@string/select_all"
        android:gravity="center_vertical"
        android:layout_gravity="center_vertical"
        android:textColor="#3D3D3D"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="@+id/ivDelAllSelect"
        app:layout_constraintEnd_toStartOf="@+id/ivDelAllSelect"
        app:layout_constraintTop_toTopOf="@+id/ivDelAllSelect" />

</androidx.constraintlayout.widget.ConstraintLayout>
