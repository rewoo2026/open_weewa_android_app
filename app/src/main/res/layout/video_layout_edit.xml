<?xml version="1.0" encoding="utf-8"?><!-- 第二种大图样式, 用在推荐列表里 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/video_edit_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:showIn="@layout/activity_phone_video_list_detail">

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/title_line" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:layout_marginTop="1dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tab_download"
            style="@style/videoEditTabButtonStyle"
            android:layout_gravity="center_vertical"
            android:drawableTop="@mipmap/video_edit_download"
            android:text="@string/video_tab_download"
            android:textColor="@drawable/video_edit_tab_text_select"
            />

        <TextView
            android:id="@+id/tab_share"
            style="@style/videoEditTabButtonStyle"
            android:layout_gravity="center_vertical"
            android:drawableTop="@drawable/ic_share"
            android:text="@string/video_tab_share"
            android:textColor="@drawable/video_edit_tab_text_select"
            tools:visibility="visible"
            />

        <TextView
            android:id="@+id/tab_rename"
            style="@style/videoEditTabButtonStyle"
            android:layout_gravity="center_vertical"
            android:drawableTop="@drawable/ic_edit"
            android:text="@string/video_tab_rename"
            android:textColor="@drawable/video_edit_tab_text_select"
            tools:visibility="visible"

            />


        <TextView
            android:id="@+id/tab_delete"
            style="@style/videoEditTabButtonStyle"
            android:layout_gravity="center_vertical"
            android:drawableTop="@mipmap/video_edit_delete"
            android:text="@string/video_tab_delete"
            android:textColor="@drawable/video_edit_tab_text_select"
            />

        <TextView
            android:id="@+id/tab_upload"
            style="@style/videoEditTabButtonStyle"
            android:layout_gravity="center_vertical"
            android:drawableTop="@mipmap/video_edit_upload"
            android:text="@string/video_tab_upload"
            android:textColor="@drawable/video_edit_tab_text_select"
            />


        <TextView
            android:id="@+id/tab_download_to_phone"
            style="@style/videoEditTabButtonStyle"
            android:layout_gravity="center_vertical"
            android:drawableTop="@mipmap/video_edit_download"
            android:text="@string/video_tab_download_to_phone"
            android:textColor="@drawable/video_edit_tab_text_select"
            />


    </LinearLayout>

</FrameLayout>