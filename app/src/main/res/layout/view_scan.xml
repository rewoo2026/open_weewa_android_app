<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <com.xh.hotme.widget.scan.FinderView
        android:id="@+id/finder_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="center"
            android:src="@mipmap/common_title_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:paddingRight="48dp"
            android:text="@string/scan_title"
            android:textColor="#ffffff"
            android:textSize="16sp" />


    </LinearLayout>

    <com.xh.hotme.widget.scan.RayView
        android:id="@+id/ray_view"
        android:layout_width="270dp"
        android:layout_height="280dp"
        android:layout_centerInParent="true"
        android:background="@mipmap/custom_scan_ray" />

    <TextView
        android:id="@+id/tip_tv"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/ray_view"
        android:layout_centerHorizontal="true"
        android:layout_marginBottom="20dp"

        android:includeFontPadding="false"
        android:paddingStart="12dp"
        android:paddingTop="6dp"
        android:paddingEnd="12dp"
        android:paddingBottom="6dp"
        android:text="@string/scan_tip"
        android:textColor="#ffffff"
        android:textSize="14sp" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="120dp"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="60dp"
        android:gravity="center"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/llt_torch"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/iv_light"
                android:layout_width="53dp"
                android:layout_height="53dp"
                android:background="@mipmap/ic_scan_imgbg"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@mipmap/ic_scan_torch" />

            <TextView
                android:id="@+id/tv_torch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/scan_open_torch"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/llt_loc"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_alignParentBottom="true"
            android:layout_weight="1"

            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="53dp"
                android:layout_height="53dp"
                android:background="@mipmap/ic_scan_imgbg"
                android:padding="10dp"
                android:scaleType="fitXY"
                android:src="@mipmap/ic_scan_imgloc" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/from_album"
                android:textColor="@color/white"
                android:textSize="12sp" />

        </LinearLayout>
    </LinearLayout>


</merge>