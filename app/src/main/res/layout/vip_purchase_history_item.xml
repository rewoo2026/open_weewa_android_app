<?xml version="1.0" encoding="utf-8"?>
<!--  通过cardview添加阴影效果  -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    android:layout_marginLeft="4dp"
    android:layout_marginRight="4dp"
    android:layout_gravity="center"
    app:cardCornerRadius="20dp"
    app:cardBackgroundColor="@color/white"
    app:contentPaddingTop="10dp"
    app:contentPaddingBottom="20dp"
    app:contentPaddingLeft="10dp"
    app:contentPaddingRight="10dp"
    >

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:tools="http://schemas.android.com/tools"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/iv_service"
                android:layout_width="35dp"
                android:scaleType="fitXY"
                android:layout_height="35dp"
                android:layout_gravity="center_vertical"
                android:src="@mipmap/vip_diamon_pro_service" />

            <TextView
                android:id="@+id/tv_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_gravity="center_vertical"
                android:textColor="@color/text_black"
                android:textFontWeight="500"
                android:textSize="24sp"
                tools:text="基础服务" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />


            <TextView
                android:id="@+id/tv_description"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:textColor="#F0633B"
                android:textFontWeight="500"
                android:textSize="18sp"
                tools:text="12个月" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:layout_marginTop="10dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"
                android:text="@string/expired_time_label"
                android:textColor="@color/text_black_3D"
                android:textFontWeight="400"
                android:visibility="gone"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_expired_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"
                android:visibility="gone"
                android:textColor="@color/text_lowgray"
                android:textFontWeight="400"
                android:textSize="14sp"
                tools:text="2024-12-12" />


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"
                android:text="@string/purchase_time_label"
                android:textColor="@color/text_black_3D"
                android:textFontWeight="400"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_start_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"
                android:textColor="@color/text_lowgray"
                android:textFontWeight="400"
                android:textSize="14sp"
                tools:text="2024-12-12" />


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"
                android:text="@string/purchase_type_label"
                android:textColor="@color/text_black_3D"
                android:textFontWeight="400"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tv_purchase_source"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"
                android:textColor="@color/text_lowgray"
                android:textFontWeight="400"
                android:textSize="14sp"
                tools:text="app" />


        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>
