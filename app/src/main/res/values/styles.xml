<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
       Base application theme, dependent on API level. This theme is replaced
       by AppBaseTheme from res/values-vXX/styles.xml on newer devices.

   -->
    <style name="AppBaseTheme" parent="android:Theme.NoTitleBar">
        <!--
            Theme customizations available in newer API levels can go in
            res/values-vXX/styles.xml, while customizations related to
            backward-compatibility can go here.

        -->
    </style>

    <!-- Base application theme. -->
    <style name="HotmeAppTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:fontFamily">@font/sourcehansans</item>
        <!-- 建议再加一句，去除字体自带的padding -->
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Mgc.Dialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
    
    <style name="hotme_transparent_dialog" parent="android:Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>

    <style name="hotme_modal_dialog" parent="android:Theme.Dialog">
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>

    <style name="hotme_custom_dialog" parent="android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:background">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@style/hotme_DialogAnimation.SlideUp</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="hotme_dialog" parent="android:Theme.Dialog"></style>

    <style name="hotme_dialog.NoFrame">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowCloseOnTouchOutside">false</item>
    </style>

    <style name="hotme_DialogAnimation">
    </style>

    <style name="hotme_DialogAnimation.Popup">
        <item name="android:windowEnterAnimation">@anim/popup_show</item>
        <item name="android:windowExitAnimation">@anim/popup_hide</item>
    </style>

    <style name="hotme_DialogAnimation.SlideUp">
        <item name="android:windowEnterAnimation">@anim/slide_in_up</item>
        <item name="android:windowExitAnimation">@anim/slide_out_down</item>
    </style>


    <!-- Application theme. -->
    <style name="leto_NoTitle_AppTheme" parent="AppBaseTheme">
        <!-- All customizations that are NOT specific to a particular API-level can go here. -->
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
    <style name="leto_dialog_bg_style" parent="android:style/Theme.Dialog">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:background">@android:color/transparent</item>
    </style>
    <style name="customDialog" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item>
        <item name="android:windowIsFloating">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@android:style/Animation.Dialog</item>
    </style>
    <style name="leto_FullscreenTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- Customize your theme here. -->
    </style>

    <style name="tabButtonStyle">
        <item name="android:layout_width">0px</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:background">@null</item>
        <item name="android:padding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@drawable/tab_text_select</item>
    </style>


    <style name="hotme_modal_dialog_ly" parent="@android:style/Theme.Dialog">
        <item name="android:windowFrame">@null</item> <!--边框-->
        <item name="android:windowIsFloating">false</item> <!--是否浮现在activity之上-->
        <item name="android:windowIsTranslucent">true</item> <!--半透明-->
        <item name="android:windowNoTitle">true</item> <!--无标题-->
        <item name="android:background">#66000000</item> <!--背景透明-->
        <item name="android:windowBackground">@android:color/transparent</item> <!--背景透明-->
        <item name="android:backgroundDimEnabled">true</item> <!--模糊-->
        <item name="android:backgroundDimAmount">0.2</item> <!--背景透明度-->
    </style>

    <!--带底部弹出动画的Dialog样式-->
    <style name="_bottomDialogAnimation">
        <!--<item name="android:windowEnterAnimation">@anim/dialog_slid_up</item>-->
        <item name="android:windowExitAnimation">@anim/slide_out_down</item>
        <item name="android:windowEnterAnimation">@anim/slide_in_up</item>
        <item name="android:activityOpenEnterAnimation">@anim/slide_in_up</item>
        <item name="android:activityOpenExitAnimation">@anim/slide_out_down</item>
        <item name="android:activityCloseEnterAnimation">@anim/slide_in_up</item>
        <item name="android:activityCloseExitAnimation">@anim/slide_out_down</item>
    </style>

    <style name="MyDialogStyleBottom" parent="Theme.AppCompat.Light.NoActionBar" >
        <item name="android:windowFrame">@null</item><!--边框-->
        <item name="android:windowIsTranslucent">true</item><!--半透明-->
        <item name="android:windowNoTitle">true</item><!--无标题-->
        <item name="android:windowBackground">@android:color/transparent</item><!--背景透明-->
        <item name="android:windowFullscreen">false</item>
        <item name="android:backgroundDimEnabled">false</item><!--模糊-->
    </style>


    <style name="videoEditTabButtonStyle">
        <item name="android:layout_width">0px</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:background">@null</item>
        <item name="android:padding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@drawable/video_edit_tab_text_select</item>
        <item name="android:drawablePadding">4dp</item>

    </style>

    <!--数字进度条样式：用于版本更新  -->
    <style name="NumberProgressBar_Default">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_width">match_parent</item>

        <item name="progress_max">100</item>
        <item name="progress_current">0</item>

        <item name="progress_unreached_color">#F4F4F4</item>
        <item name="progress_reached_color">#F16C2F</item>

        <item name="progress_text_size">16sp</item>
        <item name="progress_text_color">#fff</item>
        <item name="progress_reached_bar_height">11dp</item>
        <item name="progress_unreached_bar_height">10dp</item>
        <item name="progress_dot_radius">6dp</item>
        <item name="progress_dot_color">#F1E72F</item>
        <item name="progress_text_bg_color">#FCCF39</item>
    </style>

    <style name="HotMeToast">
        <item name="stTextBold">true</item>
        <item name="stTextColor">#fff</item>
        <item name="stTextSize">14sp</item>
        <item name="stColorBackground">#000</item>
        <item name="stSolidBackground">true</item>
        <item name="stStrokeWidth">0dp</item>
        <item name="stStrokeColor">#000</item>
        <item name="stLength">SHORT</item>
        <item name="stGravity">center</item>
        <item name="stRadius">12dp</item>
    </style>

    <style name="HotMeToast.Long">
        <item name="stLength">LONG</item>
    </style>

    <style name="ScoreCenterHostTabButton">
        <item name="android:layout_width">0px</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/tablelayout_host_cell_selector</item>
        <item name="android:padding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@drawable/tablelayout_host_cell_text_selector</item>
    </style>
    <style name="ScoreCenterGuestTabButton">
        <item name="android:layout_width">0px</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/tablelayout_guest_cell_selector</item>
        <item name="android:padding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@drawable/tablelayout_host_cell_text_selector</item>
    </style>
    <style name="ScoreCenterSecondTabButton">
        <item name="android:layout_width">0px</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/tablelayout_guest_cell</item>
        <item name="android:padding">4dp</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/white</item>
    </style>


    <!--带左边弹出动画的Dialog样式-->
    <style name="_leftDialogAnimation">
        <!--<item name="android:windowEnterAnimation">@anim/dialog_slid_up</item>-->
        <item name="android:windowExitAnimation">@anim/slide_out_left</item>
        <item name="android:windowEnterAnimation">@anim/slide_in_left</item>
    </style>

    <!--带右边弹出动画的Dialog样式-->
    <style name="_rightDialogAnimation">
        <!--<item name="android:windowEnterAnimation">@anim/dialog_slid_up</item>-->
        <item name="android:windowExitAnimation">@anim/slide_out_right</item>
        <item name="android:windowEnterAnimation">@anim/slide_in_left</item>
    </style>
</resources>